<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:mainWindowTabs="clr-namespace:SS14.Launcher.ViewModels.MainWindowTabs"
             xmlns:loc="clr-namespace:SS14.Launcher.Localization"
             xmlns:views="clr-namespace:SS14.Launcher.Views"
             xmlns:colorControls="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls.ColorPicker"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="SS14.Launcher.Views.MainWindowTabs.OptionsTabView"
             Name="NewsTab">
  <Design.DataContext>
    <mainWindowTabs:OptionsTabViewModel />
  </Design.DataContext>

  <UserControl.Resources>
    <mainWindowTabs:ThemeDescriptionConverter x:Key="ThemeDescriptionConverter" />
    <mainWindowTabs:HideLevelDescriptionConverter x:Key="HideLevelDescriptionConverter" />
  </UserControl.Resources>

  <UserControl.Styles>
    <Style Selector="ComboBox.SettingsCombo">
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="MinWidth" Value="220" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style Selector="ColorPicker.SettingsColorPicker">
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="Width" Value="260" />
    </Style>
    <Style Selector="Button.SettingsButton">
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="MinWidth" Value="120" />
      <Setter Property="Padding" Value="12,5" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style Selector="Button.SettingsButton.Compact">
      <Setter Property="MinWidth" Value="90" />
    </Style>

    <Style Selector="TextBox.SettingsInput">
      <Setter Property="MinWidth" Value="260" />
      <Setter Property="MaxWidth" Value="800" />
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <Style Selector="Border.UpdatesSectionCard">
      <Setter Property="Background" Value="#16000000" />
      <Setter Property="BorderBrush" Value="#3A6B6F8F" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="12" />
    </Style>

    <Style Selector="Border.UpdatesHeroCard">
      <Setter Property="Background" Value="#223E6C45" />
      <Setter Property="BorderBrush" Value="#7A8E94B8" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="12,10" />
    </Style>

    <Style Selector="ListBox.UpdatesVersionsList">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="ClipToBounds" Value="True" />
    </Style>

    <Style Selector="ListBox.UpdatesVersionsList > ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0,0,0,8" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="ClipToBounds" Value="True" />
    </Style>

    <Style Selector="ListBox.UpdatesVersionsList > ListBoxItem:selected">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <Style Selector="ListBox.UpdatesVersionsList > ListBoxItem:pointerover">
      <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="ListBox.UpdatesVersionsList > ListBoxItem:focus">
      <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="ListBox.UpdatesVersionsList > ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style Selector="Border.update-version-card">
      <Setter Property="Background" Value="#1AFFFFFF" />
      <Setter Property="BorderBrush" Value="#33575B7F" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="ClipToBounds" Value="True" />
    </Style>

    <Style Selector="ListBox.UpdatesVersionsList > ListBoxItem:pointerover Border.update-version-card">
      <Setter Property="Background" Value="#2A575B7F" />
      <Setter Property="BorderBrush" Value="#AA8E94B8" />
    </Style>

    <Style Selector="ListBox.UpdatesVersionsList > ListBoxItem:selected Border.update-version-card">
      <Setter Property="Background" Value="#2E3E6C45" />
      <Setter Property="BorderBrush" Value="#FF8E94B8" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>

    <Style Selector="ListBox.UpdatesVersionsList > ListBoxItem:selected Border.update-version-card Border.update-version-indicator">
      <Setter Property="Background" Value="#8E94B8" />
    </Style>

    <Style Selector="Border.update-version-channel">
      <Setter Property="Padding" Value="8,2" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Background" Value="#2A5FA8" />
    </Style>
  </UserControl.Styles>

  <TabControl>
    <TabItem Header="{loc:Loc tab-options-general-tab}">
      <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <DockPanel>
          <Button Content="{loc:Loc tab-options-flip}" DockPanel.Dock="Bottom" HorizontalAlignment="Right" Name="Flip" />
          <Button Name="ClearEnginesButton" Content="{loc:Loc tab-options-clear-engines}" DockPanel.Dock="Bottom"
                  HorizontalAlignment="Left" Click="ClearEnginesPressed" />
          <Button Name="ClearServerContentButton" Content="{loc:Loc tab-options-clear-content}" DockPanel.Dock="Bottom"
                  HorizontalAlignment="Left" Click="ClearServerContentPressed" />
          <Button Content="{loc:Loc tab-options-open-log-directory}" DockPanel.Dock="Bottom" HorizontalAlignment="Left"
                  Command="{Binding OpenLogDirectory}"/>

          <StackPanel Orientation="Vertical">
            <views:LanguageSelector HorizontalAlignment="Left" Margin="4" DataContext="{Binding Language}"
                                    Placement="BottomEdgeAlignedLeft" />
            <Button Content="{loc:Loc tab-options-account-settings}" Margin="4" Command="{Binding OpenAccountSettings}" HorizontalAlignment="Left" />
            <TextBlock VerticalAlignment="Center" TextWrapping="Wrap"
                       Text="{loc:Loc tab-options-account-settings-desc}"
                       Margin="8" />

            <CheckBox VerticalAlignment="Center" IsVisible="{Binding !DisableIncompatibleMacOS}"
                      Margin="4" IsChecked="{Binding CompatMode}" Content="{loc:Loc tab-options-compatibility-mode}" />
            <CheckBox VerticalAlignment="Center" IsVisible="{Binding DisableIncompatibleMacOS}"
                      Margin="4" IsChecked="False" IsEnabled="False" Opacity="0.8" Content="{loc:Loc tab-options-compatibility-mode}" />
            <TextBlock VerticalAlignment="Center" IsVisible="{Binding !DisableIncompatibleMacOS}" TextWrapping="Wrap"
                       Text="{loc:Loc tab-options-compatibility-mode-desc}"
                       Margin="8" />
            <TextBlock VerticalAlignment="Center" IsVisible="{Binding DisableIncompatibleMacOS}" TextWrapping="Wrap"
                       Text="{loc:Loc tab-options-desc-incompatible}"
                       Margin="8" />

            <CheckBox VerticalAlignment="Center" Margin="4" IsChecked="{Binding LogLauncherVerbose}" Content="{loc:Loc tab-options-verbose-launcher-logging}" />
            <TextBlock VerticalAlignment="Center" TextWrapping="Wrap"
                       Text="{loc:Loc tab-options-verbose-launcher-logging-desc}"
                       Margin="8" />

            <CheckBox VerticalAlignment="Center" Margin="4" IsChecked="{Binding OverrideAssets}" Content="{loc:Loc tab-options-seasonal-branding}" />
            <TextBlock VerticalAlignment="Center" TextWrapping="Wrap"
                       Text="{loc:Loc tab-options-seasonal-branding-desc}"
                       Margin="8" />

            <Button Click="OpenHubSettings" Content="{loc:Loc tab-options-hub-settings}" Margin="4" HorizontalAlignment="Left" />
            <TextBlock VerticalAlignment="Center" TextWrapping="Wrap"
                       Text="{loc:Loc tab-options-hub-settings-desc}"
                       Margin="8" />
          </StackPanel>
        </DockPanel>
      </ScrollViewer>
    </TabItem>

    <TabItem Header="{loc:Loc tab-options-helix-tab}">
      <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="12" Spacing="16">
          <StackPanel Spacing="6">
            <TextBlock Text="{loc:Loc tab-options-helix-server-list-title}" Classes="NanoHeadingMedium" />
            <TextBlock Text="{loc:Loc tab-options-helix-server-list-desc}" Opacity="0.6" TextWrapping="Wrap" />
            <CheckBox Margin="4" IsChecked="{Binding ServerListShowMode}" Content="{loc:Loc tab-options-helix-show-mode}" />
            <CheckBox Margin="4" IsChecked="{Binding ServerListShowMap}" Content="{loc:Loc tab-options-helix-show-map}" />
            <CheckBox Margin="4" IsChecked="{Binding ServerListShowPing}" Content="{loc:Loc tab-options-helix-show-ping}" />
          </StackPanel>

          <Separator Height="1" Opacity="0.1" Background="White" />

          <StackPanel Spacing="6">
            <TextBlock Text="{loc:Loc tab-options-helix-discord-rpc-title}" Classes="NanoHeadingMedium" />
            <TextBlock Text="{loc:Loc tab-options-helix-discord-rpc-desc}" Opacity="0.6" TextWrapping="Wrap" />
            <CheckBox Margin="4" IsChecked="{Binding HelixDiscordRichPresenceEnabled}" Content="{loc:Loc tab-options-helix-discord-rpc-enabled}" />

            <TextBlock Text="{loc:Loc tab-options-helix-discord-rpc-in-game-title}" Classes="NanoHeadingSmall" Margin="4,8,4,2" />
            <RadioButton Margin="4,2" GroupName="HelixDiscordInGamePresenceMode" IsChecked="{Binding HelixDiscordInGameUseOriginal}" Content="{loc:Loc tab-options-helix-discord-rpc-in-game-original}" />
            <RadioButton Margin="4,2" GroupName="HelixDiscordInGamePresenceMode" IsChecked="{Binding HelixDiscordInGameUseHelix}" Content="{loc:Loc tab-options-helix-discord-rpc-in-game-helix}" />
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </TabItem>

    <TabItem Header="{loc:Loc tab-options-resource-packs-tab}">
      <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="12" Spacing="12">
          <TextBlock Text="{loc:Loc tab-resource-packs-header}" Classes="NanoHeadingMedium" />
          <TextBlock Text="{loc:Loc tab-resource-packs-desc}" Opacity="0.65" TextWrapping="Wrap" />
          <TextBlock Text="{Binding ResourcePacksDirectory}" Classes="SubText" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="{loc:Loc tab-resource-packs-open-directory}" Click="OpenResourcePacksDirectory" />
            <Button Content="{loc:Loc tab-resource-packs-reload}" Click="ReloadResourcePacks" />
          </StackPanel>
          <TextBlock Text="{loc:Loc tab-resource-packs-empty}" IsVisible="{Binding !HasResourcePacks}" Opacity="0.65" TextWrapping="Wrap" />
          <ItemsControl ItemsSource="{Binding ResourcePacks}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border BorderBrush="{DynamicResource ThemeBorderMidBrush}" BorderThickness="1" Padding="10" Margin="0,0,0,6">
                  <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
                    <StackPanel Grid.Column="0" Spacing="2">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding Description}" IsVisible="{Binding HasDescription}" Opacity="0.65" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding DirectoryName}" Classes="SubText" />
                    </StackPanel>
                    <CheckBox Grid.Column="1" Content="{loc:Loc tab-resource-packs-enabled}" IsChecked="{Binding Enabled}" Checked="ResourcePackEnabledChanged" Unchecked="ResourcePackEnabledChanged" />
                    <StackPanel Grid.Column="1" Grid.Row="2" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right">
                      <Button Content="↑" Click="MoveResourcePackUp" />
                      <Button Content="↓" Click="MoveResourcePackDown" />
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>
    </TabItem>

    <TabItem Header="{loc:Loc tab-options-configs-tab}">
      <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="12" Spacing="12">
          <TextBlock Text="{loc:Loc tab-configs-title}" Classes="NanoHeadingMedium" />
          <TextBlock Text="{loc:Loc tab-configs-desc}" Opacity="0.65" TextWrapping="Wrap" />
          <TextBlock Text="{Binding KeybindConfigsDirectory}" Classes="SubText" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="{loc:Loc tab-configs-open-directory}" Click="OpenKeybindConfigsDirectory" />
            <Button Content="{loc:Loc tab-configs-import-current}" Click="ImportCurrentKeybinds" />
            <Button Content="{loc:Loc tab-configs-clear-selection}" Click="ClearKeybindConfigSelection" />
            <Button Content="{loc:Loc tab-configs-reload}" Click="ReloadKeybindConfigs" />
          </StackPanel>
          <TextBlock Text="{loc:Loc tab-configs-empty}" IsVisible="{Binding !HasKeybindConfigs}" Opacity="0.65" TextWrapping="Wrap" />
          <ItemsControl ItemsSource="{Binding KeybindConfigs}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border BorderBrush="{DynamicResource ThemeBorderMidBrush}" BorderThickness="1" Padding="10" Margin="0,0,0,6">
                  <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                    <TextBlock Grid.Row="1" Text="{Binding FileName}" Classes="SubText" />
                    <TextBlock Grid.Column="1" Text="{loc:Loc tab-configs-selected}" IsVisible="{Binding Selected}" Foreground="{DynamicResource ThemeNanoGoldBrush}" />
                    <StackPanel Grid.Column="1" Grid.Row="1" Orientation="Horizontal" Spacing="6">
                      <Button Content="{loc:Loc tab-configs-select}" Click="SelectKeybindConfig" />
                      <Button Content="{loc:Loc tab-configs-delete}" Click="DeleteKeybindConfig" />
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>
    </TabItem>

    <TabItem Header="{loc:Loc launcher-themes-title}">
      <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="12" Spacing="16">
          <StackPanel Spacing="6">
            <TextBlock Text="{loc:Loc launcher-themes-theme}" Classes="NanoHeadingMedium" />
            <TextBlock Text="{loc:Loc launcher-themes-theme-desc}" Opacity="0.6" TextWrapping="Wrap" />
            <ComboBox Classes="SettingsCombo" ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme}" Width="300" Margin="4,0,0,0">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Converter={StaticResource ThemeDescriptionConverter}}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>

          <StackPanel Spacing="8" IsVisible="{Binding IsCustomThemeSelected}">
            <TextBlock Text="{loc:Loc launcher-themes-custom-colors}" Classes="NanoHeadingSmall" />
            <TextBlock Text="{loc:Loc launcher-themes-custom-colors-desc}" Opacity="0.6" TextWrapping="Wrap" />
            <TextBlock Text="{loc:Loc launcher-themes-background}" />
            <colorControls:ColorPicker Classes="SettingsColorPicker" IsAlphaEnabled="False" IsAlphaVisible="False" Color="{Binding CustomThemeBackground, Mode=TwoWay}" />
            <TextBlock Text="{loc:Loc launcher-themes-accent}" />
            <colorControls:ColorPicker Classes="SettingsColorPicker" IsAlphaEnabled="False" IsAlphaVisible="False" Color="{Binding CustomThemeAccent, Mode=TwoWay}" />
            <TextBlock Text="{loc:Loc launcher-themes-text}" />
            <colorControls:ColorPicker Classes="SettingsColorPicker" IsAlphaEnabled="False" IsAlphaVisible="False" Color="{Binding CustomThemeForeground, Mode=TwoWay}" />
            <TextBlock Text="{loc:Loc launcher-themes-popup}" />
            <colorControls:ColorPicker Classes="SettingsColorPicker" IsAlphaEnabled="False" IsAlphaVisible="False" Color="{Binding CustomThemePopup, Mode=TwoWay}" />
            <TextBlock Text="{loc:Loc launcher-themes-gradient-start}" />
            <colorControls:ColorPicker Classes="SettingsColorPicker" IsAlphaEnabled="False" IsAlphaVisible="False" Color="{Binding CustomThemeGradientStart, Mode=TwoWay}" />
            <TextBlock Text="{loc:Loc launcher-themes-gradient-end}" />
            <colorControls:ColorPicker Classes="SettingsColorPicker" IsAlphaEnabled="False" IsAlphaVisible="False" Color="{Binding CustomThemeGradientEnd, Mode=TwoWay}" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Classes="SettingsButton Compact" Content="{loc:Loc launcher-themes-reset}" Click="ResetCustomTheme" />
              <Button Classes="SettingsButton Compact" Content="{loc:Loc launcher-themes-import}" Click="ImportCustomTheme" />
              <Button Classes="SettingsButton Compact" Content="{loc:Loc launcher-themes-export}" Click="ExportCustomTheme" />
            </StackPanel>
          </StackPanel>

          <StackPanel Spacing="6">
            <CheckBox IsChecked="{Binding ThemeGradient}" Content="{loc:Loc launcher-themes-gradient}" />
            <TextBlock Text="{loc:Loc launcher-themes-gradient-desc}" Margin="26,0,0,0" Opacity="0.6" TextWrapping="Wrap" />
            <CheckBox IsChecked="{Binding ThemeDecor}" Content="{loc:Loc launcher-themes-decor}" />
            <TextBlock Text="{loc:Loc launcher-themes-decor-desc}" Margin="26,0,0,0" Opacity="0.6" TextWrapping="Wrap" />
          </StackPanel>

          <Separator Height="1" Opacity="0.1" Background="White" />
          <StackPanel Spacing="8">
            <TextBlock Text="{loc:Loc launcher-themes-font}" Classes="NanoHeadingSmall" />
            <TextBlock Text="{loc:Loc launcher-themes-font-desc}" Opacity="0.6" TextWrapping="Wrap" />
            <DockPanel MaxWidth="500" HorizontalAlignment="Left">
              <Button Classes="SettingsButton Compact" DockPanel.Dock="Right" Content="{loc:Loc launcher-themes-font-load}" Click="PickCustomFont" Margin="8,0,0,0" />
              <ComboBox Classes="SettingsCombo" ItemsSource="{Binding ThemeFonts}" SelectedItem="{Binding SelectedThemeFont}">
                <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate>
              </ComboBox>
            </DockPanel>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </TabItem>
    <TabItem Header="{loc:Loc tab-options-plugins-tab}">
      <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="12" Spacing="14">
          <StackPanel Spacing="6">
            <TextBlock Text="{loc:Loc tab-options-plugins-hide-level}" Classes="NanoHeadingMedium" />
            <TextBlock Text="{loc:Loc tab-options-plugins-hide-level-desc}" Opacity="0.6" TextWrapping="Wrap" />
            <ComboBox Classes="SettingsCombo" Width="300" Margin="4,0,0,0" ItemsSource="{Binding HideLevels}" SelectedItem="{Binding HideLevel}">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Margin="8,4,0,0" Opacity="0.75" TextWrapping="Wrap"
                       Text="{Binding HideLevel, Converter={StaticResource HideLevelDescriptionConverter}}" />
          </StackPanel>

          <Separator Height="1" Opacity="0.1" Background="White" />

          <StackPanel Spacing="6">
            <TextBlock Text="{loc:Loc tab-options-plugins-game}" Classes="NanoHeadingMedium" />
            <CheckBox Margin="4" IsChecked="{Binding DisableRPC}" Content="{loc:Loc tab-options-plugins-disable-rpc}" />
            <TextBlock Margin="26,0,0,0" Opacity="0.6" TextWrapping="Wrap" Text="{loc:Loc tab-options-plugins-disable-rpc-desc}" />

            <CheckBox Margin="4" IsChecked="{Binding FakeRPC}" Content="{loc:Loc tab-options-plugins-fake-rpc}" />
            <TextBlock Margin="26,0,0,0" Opacity="0.6" TextWrapping="Wrap" Text="{loc:Loc tab-options-plugins-fake-rpc-desc}" />
            <StackPanel IsVisible="{Binding FakeRPC}" Spacing="4">
              <TextBlock Margin="8,2" Opacity="0.75" TextWrapping="Wrap" Text="{loc:Loc tab-options-plugins-fake-rpc-username-desc}" />
              <TextBox Width="600" MaxWidth="1000" HorizontalAlignment="Left" Margin="4,0,0,0"
                       Text="{Binding RPCUsername, Mode=TwoWay}" />
              <Button Classes="SettingsButton Compact" HorizontalAlignment="Left" Margin="4,4,0,0"
                      Content="{loc:Loc tab-options-plugins-fake-rpc-set}" Command="{Binding SetRPCUsernameCommand}" />
            </StackPanel>

            <CheckBox Margin="4" IsChecked="{Binding DisableRedial}" Content="{loc:Loc tab-options-plugins-disable-redial}" />
            <TextBlock Margin="26,0,0,0" Opacity="0.6" TextWrapping="Wrap" Text="{loc:Loc tab-options-plugins-disable-redial-desc}" />

            <CheckBox Margin="4" IsChecked="{Binding Blackhole}" Content="{loc:Loc tab-options-plugins-blackhole}" />
            <TextBlock Margin="26,0,0,0" Opacity="0.6" TextWrapping="Wrap" Text="{loc:Loc tab-options-plugins-blackhole-desc}" />

            <CheckBox Margin="4" IsChecked="{Binding Patchless}" Content="{loc:Loc tab-options-plugins-patchless}" />
            <TextBlock Margin="26,0,0,0" Opacity="0.6" TextWrapping="Wrap" Text="{loc:Loc tab-options-plugins-patchless-desc}" />
          </StackPanel>

          <Separator Height="1" Opacity="0.1" Background="White" />

          <StackPanel Spacing="6">
            <TextBlock Text="{loc:Loc tab-options-plugins-hwid}" Classes="NanoHeadingMedium" />
            <CheckBox Margin="4" IsChecked="{Binding HWID2OptOut}" Content="{loc:Loc tab-options-plugins-hwid2-optout}" />
            <StackPanel Margin="26,0,0,0" Spacing="2">
              <TextBlock Opacity="0.6" TextWrapping="Wrap" Text="{loc:Loc tab-options-plugins-hwid2-optout-desc}" />
              <TextBlock FontWeight="Bold" TextWrapping="Wrap" Text="{loc:Loc tab-options-plugins-hwid2-optout-warn}" />
            </StackPanel>

            <CheckBox Margin="4" IsChecked="{Binding ForcingHWID}" Content="{loc:Loc tab-options-plugins-force-hwid}" />
            <TextBlock Margin="26,0,0,0" Opacity="0.6" TextWrapping="Wrap" Text="{loc:Loc tab-options-plugins-force-hwid-desc}" />

            <StackPanel IsVisible="{Binding ForcingHWID}" Spacing="4">
              <CheckBox Margin="4,0" IsChecked="{Binding LIHWIDBind}" Content="{loc:Loc tab-options-plugins-li-hwid-bind}" />
              <TextBlock Margin="26,0,0,0" Opacity="0.6" TextWrapping="Wrap" Text="{loc:Loc tab-options-plugins-li-hwid-bind-desc}" />

              <TextBlock Margin="8,8,0,0" Opacity="0.75" TextWrapping="Wrap" Text="{loc:Loc tab-options-plugins-hwid-change-desc}" />
              <TextBox Width="600" MaxWidth="1000" HorizontalAlignment="Left" Margin="4,0,0,0"
                       BorderBrush="{Binding HWIDTextBoxBorderBrush}"
                       Text="{Binding HWIdString, Mode=TwoWay}" />
              <StackPanel Orientation="Horizontal" Spacing="8" Margin="4,4,0,0">
                <Button Classes="SettingsButton Compact" Content="{loc:Loc tab-options-plugins-set-hwid}" Command="{Binding SetHWIdCommand}" />
                <Button Classes="SettingsButton Compact" Content="{loc:Loc tab-options-plugins-gen-hwid}" Command="{Binding GenHWIdCommand}" />
              </StackPanel>

              <CheckBox Margin="4,8,0,0" IsChecked="{Binding RandHWID}" Content="{loc:Loc tab-options-plugins-rand-hwid}" />
              <StackPanel Margin="26,0,0,0" Spacing="2">
                <TextBlock Opacity="0.6" TextWrapping="Wrap" Text="{loc:Loc tab-options-plugins-rand-hwid-desc}" />
                <TextBlock FontWeight="Bold" TextWrapping="Wrap" Text="{loc:Loc tab-options-plugins-rand-hwid-warn}" />
              </StackPanel>
            </StackPanel>
          </StackPanel>

          <Separator Height="1" Opacity="0.1" Background="White" />

          <StackPanel Spacing="6">
            <TextBlock Text="{loc:Loc tab-options-plugins-patching}" Classes="NanoHeadingMedium" />
            <CheckBox Margin="4" IsChecked="{Binding ThrowPatchFail}" Content="{loc:Loc tab-options-plugins-throw-patch-fail}" />
            <TextBlock Margin="26,0,0,0" Opacity="0.6" TextWrapping="Wrap" Text="{loc:Loc tab-options-plugins-throw-patch-fail-desc}" />
          </StackPanel>

          <Separator Height="1" Opacity="0.1" Background="White" />

          <StackPanel Spacing="6">
            <TextBlock Text="{loc:Loc tab-options-plugins-backports}" Classes="NanoHeadingMedium" />
            <CheckBox Margin="4" IsChecked="{Binding Backports}" Content="{loc:Loc tab-options-plugins-enable-backports}" />
            <TextBlock Margin="26,0,0,0" Opacity="0.6" TextWrapping="Wrap" Text="{loc:Loc tab-options-plugins-enable-backports-desc}" />

            <CheckBox Margin="4" IsChecked="{Binding DisableAnyEngineBackports}" Content="{loc:Loc tab-options-plugins-disable-global-backports}" />
            <TextBlock Margin="26,0,0,0" Opacity="0.6" TextWrapping="Wrap" Text="{loc:Loc tab-options-plugins-disable-global-backports-desc}" />
          </StackPanel>

          <Separator Height="1" Opacity="0.1" Background="White" />

          <StackPanel Spacing="6">
            <TextBlock Text="{loc:Loc tab-options-plugins-logging}" Classes="NanoHeadingMedium" />
            <CheckBox Margin="4" IsChecked="{Binding LogPatches}" Content="{loc:Loc tab-options-plugins-log-patcher}" />
            <TextBlock Margin="26,0,0,0" Opacity="0.6" TextWrapping="Wrap" Text="{loc:Loc tab-options-plugins-log-patcher-desc}" />

            <CheckBox Margin="4" IsChecked="{Binding LogLauncherPatcher}" Content="{loc:Loc tab-options-plugins-log-launcher-patcher}" />
            <TextBlock Margin="26,0,0,0" Opacity="0.6" TextWrapping="Wrap" Text="{loc:Loc tab-options-plugins-log-launcher-patcher-desc}" />

            <CheckBox Margin="4" IsChecked="{Binding LogLoaderDebug}" Content="{loc:Loc tab-options-plugins-log-loader-debug}" />
            <TextBlock Margin="26,0,0,0" Opacity="0.6" TextWrapping="Wrap" Text="{loc:Loc tab-options-plugins-log-loader-debug-desc}" />

            <CheckBox Margin="4" IsChecked="{Binding LogLoaderTrace}" Content="{loc:Loc tab-options-plugins-log-loader-trace}" />
            <TextBlock Margin="26,0,0,0" Opacity="0.6" TextWrapping="Wrap" Text="{loc:Loc tab-options-plugins-log-loader-trace-desc}" />

            <CheckBox Margin="4" IsChecked="{Binding SeparateLogging}" Content="{loc:Loc tab-options-plugins-separate-logging}" />
            <TextBlock Margin="26,0,0,0" Opacity="0.6" TextWrapping="Wrap" Text="{loc:Loc tab-options-plugins-separate-logging-desc}" />
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </TabItem>

    <TabItem Header="{loc:Loc launcher-updates-tab-title}">
      <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="12" Spacing="12">
          <Border Classes="UpdatesHeroCard">
            <StackPanel Spacing="6">
              <TextBlock Text="{loc:Loc launcher-updates-header}" Classes="NanoHeadingMedium" FontWeight="SemiBold" />
              <TextBlock Text="{Binding LauncherVersionsStatus}" Opacity="0.82" FontSize="12" TextWrapping="Wrap" />
            </StackPanel>
          </Border>

          <Border Classes="UpdatesSectionCard">
            <StackPanel Spacing="12">
              <StackPanel>
                <CheckBox IsChecked="{Binding LauncherAutoUpdate}" Content="{loc:Loc launcher-updates-auto}" />
                <TextBlock Text="{loc:Loc launcher-updates-auto-desc}" Margin="26,2,0,0" Opacity="0.6" FontSize="11" TextWrapping="Wrap" />
              </StackPanel>

              <StackPanel>
                <CheckBox IsChecked="{Binding LauncherUpdateNotify}" Content="{loc:Loc launcher-updates-notify}" />
                <TextBlock Text="{loc:Loc launcher-updates-notify-desc}" Margin="26,2,0,0" Opacity="0.6" FontSize="11" TextWrapping="Wrap" />
              </StackPanel>

              <StackPanel>
                <CheckBox IsChecked="{Binding LauncherUpdateAllowPreRelease}" Content="{loc:Loc launcher-updates-allow-prerelease}" />
                <TextBlock Text="{loc:Loc launcher-updates-allow-prerelease-desc}" Margin="26,2,0,0" Opacity="0.6" FontSize="11" TextWrapping="Wrap" />
              </StackPanel>

              <StackPanel Spacing="6">
                <TextBlock Text="{loc:Loc launcher-updates-repo}" Opacity="0.85" FontSize="12" />
                <TextBox Classes="SettingsInput"
                         Text="{Binding LauncherUpdateRepo, Mode=TwoWay}"
                         Watermark="{loc:Loc launcher-updates-repo-placeholder}" />
                <TextBlock Text="{loc:Loc launcher-updates-repo-desc}" Opacity="0.55" FontSize="11" TextWrapping="Wrap" />
              </StackPanel>
            </StackPanel>
          </Border>

          <Border Classes="UpdatesSectionCard">
            <StackPanel Spacing="8">
              <DockPanel LastChildFill="False">
                <Button DockPanel.Dock="Right" Classes="SettingsButton Compact" Content="{loc:Loc launcher-updates-list-refresh}" Command="{Binding RefreshLauncherVersionsCommand}" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" Margin="0,0,10,0" VerticalAlignment="Center">
                  <TextBlock Text="{loc:Loc launcher-updates-filter-label}" Opacity="0.75" VerticalAlignment="Center" />
                  <ComboBox Classes="SettingsCombo"
                            MinWidth="170"
                            ItemsSource="{Binding LauncherVersionFilters}"
                            SelectedItem="{Binding SelectedLauncherVersionFilter}">
                    <ComboBox.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding Text}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </StackPanel>
                <TextBlock DockPanel.Dock="Left" Text="{loc:Loc launcher-updates-list-title}" Classes="NanoHeadingSmall" FontWeight="SemiBold" />
              </DockPanel>

              <ProgressBar IsVisible="{Binding LauncherVersionsLoading}" IsIndeterminate="True" Height="4" />

              <Border CornerRadius="8" ClipToBounds="True">
                <ListBox Classes="UpdatesVersionsList"
                         ItemsSource="{Binding LauncherAvailableVersions}"
                         SelectedItem="{Binding SelectedLauncherVersion, Mode=TwoWay}"
                         MaxHeight="260">
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <Border Classes="update-version-card"
                              ToolTip.Tip="{Binding Tooltip}">
                        <Grid ColumnDefinitions="4,*,Auto" RowDefinitions="Auto,Auto,Auto">
                          <Border Grid.RowSpan="3" Grid.Column="0" Classes="update-version-indicator" Background="#60575B7F" CornerRadius="4" />

                          <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Title}" FontWeight="SemiBold" Margin="10,0,10,0" />
                          <Border Grid.Row="0" Grid.Column="2"
                                  Classes="update-version-channel"
                                  Background="{Binding ChannelBadgeBackground}">
                            <TextBlock Text="{Binding ChannelText}"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="{Binding ChannelBadgeForeground}" />
                          </Border>
                          <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Subtitle}" FontSize="11" Opacity="0.65" Margin="10,2,0,0" />
                          <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding NotesPreview}" FontSize="11" Opacity="0.85" Margin="10,4,0,0" TextWrapping="Wrap" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </Border>

              <DockPanel LastChildFill="False" Margin="0,2,0,0">
                <Button DockPanel.Dock="Left"
                        Classes="SettingsButton Compact"
                        Content="{loc:Loc launcher-updates-list-open}"
                        IsEnabled="{Binding CanOpenSelectedLauncherVersion}"
                        Command="{Binding OpenSelectedLauncherVersionCommand}" />
                <Button DockPanel.Dock="Right"
                        Classes="SettingsButton"
                        Content="{loc:Loc launcher-updates-list-install-selected}"
                        IsEnabled="{Binding CanInstallSelectedLauncherVersion}"
                        Command="{Binding InstallSelectedLauncherVersionCommand}" />
              </DockPanel>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </TabItem>
  </TabControl>
</UserControl>
